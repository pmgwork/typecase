    "The font is no longer in the library.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The font is no longer in the library."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォントはライブラリにありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 글꼴은 라이브러리에 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此字体已不在字体库中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此字體已不在字體庫中。"
          }
        }
