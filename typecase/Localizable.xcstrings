    "Applies to font specimens. Shared with the toolbar color controls. Choose System to follow the macOS appearance.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to font specimens. Shared with the toolbar color controls. Choose System to follow the macOS appearance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォントの見本に適用されます。ツールバーの色設定と共通です。「システム」を選ぶとmacOSの外観に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글꼴 견본에 적용되며 도구 막대의 색상 설정과 공유됩니다. macOS 모양을 따르려면 시스템을 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用于字体样张，与工具栏的颜色设置共用。选择“系统”以跟随 macOS 外观。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用至字體樣張，與工具列的顏色設定共用。選擇「系統」以跟隨 macOS 外觀。"
          }
        }
      }
    },
    "Apps find fonts by PostScript name, so only one of these files can be used.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps find fonts by PostScript name, so only one of these files can be used."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリはPostScript名でフォントを識別するため、これらのファイルのうち1つだけが使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 PostScript 이름으로 글꼴을 찾으므로 이 파일 중 하나만 사용할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用通过 PostScript 名称查找字体，因此这些文件中只能使用一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式透過 PostScript 名稱尋找字體，因此這些檔案中只能使用一個。"
          }
        }
      }
    },
