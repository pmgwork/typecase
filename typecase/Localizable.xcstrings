    "Installed fonts are read automatically. Add a folder to include the font files stored on disk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed fonts are read automatically. Add a folder to include the font files stored on disk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みのフォントは自動で読み込まれます。ディスク上のフォントを表示するにはフォルダを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 글꼴은 자동으로 불러옵니다. 디스크의 글꼴 파일을 포함하려면 폴더를 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装的字体会自动读取。添加文件夹以包含磁盘上的字体文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝的字體會自動讀取。加入檔案夾以包含磁碟上的字體檔案。"
          }
        }
      }
    },
    "Installed on this Mac — deactivate it in Font Book": {
      "localizations": {
        "en": {
