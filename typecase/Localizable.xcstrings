    "Use the toolbar’s Mixed Font button to pair a Japanese font with a Latin one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the toolbar’s Mixed Font button to pair a Japanese font with a Latin one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーの「混植フォント」で、日本語と欧文のフォントを組み合わせられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 막대의 혼합 글꼴 버튼으로 일본어와 로마자 글꼴을 조합하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用工具栏的“混排字体”按钮组合日文字体和西文字体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用工具列的「混排字體」按鈕組合日文字體和西文字體。"
          }
        }
      }
    },
    "Used in previews while the preview text field is empty; a mixed specimen uses its own Japanese, English, digits, and symbols sample.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used in previews while the preview text field is empty; a mixed specimen uses its own Japanese, English, digits, and symbols sample."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューの入力欄が空のときに使用します。混植見本には、日本語・英語・数字・記号を含む専用サンプルを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기 입력란이 비어 있을 때 사용합니다. 혼합 견본에는 일본어, 영어, 숫자, 기호가 포함된 별도 샘플을 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览文本为空时使用。混排样张使用包含日语、英语、数字和符号的专用示例。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽文字為空時使用。混排樣張使用包含日文、英文、數字和符號的專用範例。"
          }
        }
      }
    },
