    "Assign the tag to a font from the row’s context menu, or delete the tag in the sidebar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assign the tag to a font from the row’s context menu, or delete the tag in the sidebar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォント行のコンテキストメニューからタグを付けるか、サイドバーでこのタグを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글꼴 행의 메뉴에서 태그를 지정하거나 사이드바에서 태그를 삭제하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从字体行的上下文菜单分配标签，或在侧边栏中删除此标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從字體列的快顯選單指派標籤，或在側邊欄中刪除此標籤。"
          }
        }
      }
    },
