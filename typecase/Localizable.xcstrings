    "Add a block, then set it in any font in your library.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a block, then set it in any font in your library."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックを追加し、ライブラリのフォントを指定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "블록을 추가한 다음 라이브러리의 글꼴을 지정하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加区块，然后选择字体库中的任意字体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入區塊，然後選擇字體庫中的任意字體。"
          }
        }
      }
    },
    "Add a folder that contains font files to browse them without installing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a folder that contains font files to browse them without installing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォントファイルを含むフォルダを追加すると、インストールせずに閲覧できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글꼴 파일이 있는 폴더를 추가하면 설치하지 않고 볼 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加包含字体文件的文件夹，无需安装即可浏览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入包含字體檔案的檔案夾，無需安裝即可瀏覽。"
          }
        }
      }
    },
