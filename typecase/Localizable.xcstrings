{
  "sourceLanguage": "en",
  "strings": {
    "%@ · %@ · Click to edit text; press Esc, then Delete, to remove the block": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · Click to edit text; press Esc, then Delete, to remove the block"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ · クリックして編集。Escの後にDeleteを押すとブロックを削除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ · 클릭하여 편집. Esc를 누른 다음 Delete를 눌러 블록 삭제"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ · 点击编辑；先按 Esc，再按 Delete 删除区块"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ · 點按編輯；先按 Esc，再按 Delete 刪除區塊"
          }
        }
      }
    },
