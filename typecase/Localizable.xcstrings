    "Auto uses the fonts' kerning pairs; Metrics – Roman Only sets Japanese text solid; 0 turns kerning off": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto uses the fonts' kerning pairs; Metrics – Roman Only sets Japanese text solid; 0 turns kerning off"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」はフォントのカーニングペアを使用します。「メトリクス — 欧文のみ」は和文をベタ組みにし、「0」はカーニングを無効にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동은 글꼴의 커닝 쌍을 사용합니다. 메트릭 — 로마자만은 일본어를 기본 자폭으로 조판하고, 0은 커닝을 끕니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”使用字体的字偶距；“度量 — 仅西文”将日文设为实排；“0”关闭字偶距。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」使用字體的字偶間距；「度量 — 僅西文」將日文設為實排；「0」關閉字偶間距。"
          }
        }
      }
    },
