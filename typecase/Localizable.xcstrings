    "The layout could not be rendered as an image. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The layout could not be rendered as an image. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトを画像として描画できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이아웃을 이미지로 렌더링하지 못했습니다. 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将布局渲染为图像，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將版面算繪為影像，請重試。"
          }
        }
      }
    },
    "The layout’s blocks are removed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The layout’s blocks are removed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレイアウトのブロックが削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 레이아웃의 블록이 삭제됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此布局中的区块将被移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版面中的區塊將被移除。"
          }
        }
      }
    },
    "The name appears in the layout menu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name appears in the layout menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前がレイアウトメニューに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이름이 레이아웃 메뉴에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此名称会显示在布局菜单中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此名稱會顯示在版面選單中。"
          }
        }
      }
    },
    "The selected font cannot display these characters of the preview text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected font cannot display these characters of the preview text"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したフォントではプレビューテキストのこれらの文字を表示できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 글꼴로 미리보기 텍스트의 이 문자를 표시할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选字体无法显示预览文本中的这些字符"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選字體無法顯示預覽文字中的這些字元"
          }
        }
      }
    },
    "The selected style cannot display these characters": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected style cannot display these characters"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したスタイルではこれらの文字を表示できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 스타일로 이 문자를 표시할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选样式无法显示这些字符"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選樣式無法顯示這些字元"
          }
        }
      }
    },
    "The tag is renamed on every font that uses it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tag is renamed on every font that uses it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグを使用するすべてのフォントに名前の変更が反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 태그를 사용하는 모든 글꼴에서 이름이 변경됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此标签的所有字体都会更新标签名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此標籤的所有字體都會更新標籤名稱。"
          }
        }
      }
    },
    "These fonts have no OpenType features to switch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These fonts have no OpenType features to switch"
